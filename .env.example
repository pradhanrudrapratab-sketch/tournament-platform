NODE_ENV=production
PORT=10000
APP_BASE_URL=https://your-app.onrender.com

DATABASE_URL=
DATABASE_SSL=true

# Server-side (Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config (safe to expose to the browser)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# One-time admin bootstrap. Set the password ONLY in Render's env panel, never in git.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_INITIAL_PASSWORD=

# Encrypts room ID / password at rest. Use a long random string.
ROOM_CRED_KEY=

# Payment gateway (verify against the provider's real docs)
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_AMOUNT_UNIT=paise
PAYMENT_REQUIRE_AMOUNT_MATCH=true

DISCORD_INVITE_URL=
